#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

# A standalone desktop package upgrade must not remove the only browser.
test -x /usr/lib/firefox/firefox
if listing=$(LC_ALL=C snap list firefox 2>&1); then
	printf '%s\n' "$listing"
	snap remove --purge firefox
elif [ "$listing" != 'error: no matching snaps installed' ]; then
	printf '%s\n' "$listing" >&2
	exit 1
fi
install -d -m 755 /var/lib/piano
touch /var/lib/piano/firefox-snap-removed
