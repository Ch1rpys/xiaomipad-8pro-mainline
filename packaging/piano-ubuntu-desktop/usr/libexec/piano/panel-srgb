#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Give an unconfigured Piano DSI panel the distribution's standard sRGB profile.

Uses colord's system D-Bus API through GLib's Gio, which every GNOME session has,
so no Colord GObject-introspection typelib is needed.
"""
import os
from pathlib import Path
import sys

SRGB = '/usr/share/color/icc/colord/sRGB.icc'
BUS, MANAGER, DEVICE = 'org.freedesktop.ColorManager', '/org/freedesktop/ColorManager', 'org.freedesktop.ColorManager.Device'


def main():
    if ('GNOME' not in os.environ.get('XDG_CURRENT_DESKTOP', '').split(':')
            or os.environ.get('XDG_SESSION_TYPE') != 'wayland'):
        return 0
    compatible = Path('/sys/firmware/devicetree/base/compatible')
    if not compatible.exists() or b'xiaomi,piano' not in compatible.read_bytes().split(b'\0'):
        return 0

    from gi.repository import Gio, GLib

    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

    def call(path, iface, method, args=None, reply=None):
        return bus.call_sync(BUS, path, iface, method, args, GLib.VariantType(reply) if reply else None,
                             Gio.DBusCallFlags.NONE, 10000, None).unpack()

    def props(path):
        return call(path, 'org.freedesktop.DBus.Properties', 'GetAll', GLib.Variant('(s)', (DEVICE,)), '(a{sv})')[0]

    def panel(path):
        p = props(path)
        return (p.get('Kind') == 'display' and p.get('Owner') == os.getuid() and p.get('Embedded')
                and p.get('Metadata', {}).get('XRANDR_name') == 'DSI-1'), p

    def unconfigured(p):
        # A disabled/inhibited device can have no default while still holding user
        # profiles. Never replace that choice or enable color management.
        return p.get('Enabled') and not p.get('ProfilingInhibitors') and not p.get('Profiles')

    loop = GLib.MainLoop()
    state = {'done': False, 'result': 0}

    def consider(path):
        if state['done']:
            return
        try:
            ours, p = panel(path)
            if not ours:
                return
            if unconfigured(p):
                if not Path(SRGB).is_file():
                    raise RuntimeError(f'distribution sRGB profile missing: {SRGB}')
                profile = call(MANAGER, BUS, 'FindProfileByFilename', GLib.Variant('(s)', (SRGB,)), '(o)')[0]
                # Re-read after the lookup: soft associations rank below user/system
                # hard associations, including a concurrent choice.
                if unconfigured(props(path)):
                    call(path, DEVICE, 'AddProfile', GLib.Variant('(so)', ('soft', profile)))
                    print('DSI-1: associated distribution sRGB (soft)', flush=True)
                else:
                    print('DSI-1: preserved changed color configuration', flush=True)
            else:
                print('DSI-1: preserved existing color configuration', flush=True)
        except (GLib.Error, OSError, RuntimeError) as error:
            print(f'panel-srgb: {error}', file=sys.stderr, flush=True)
            state['result'] = 1
        state['done'] = True
        loop.quit()

    # Subscribe before enumerating so asynchronous Mutter device creation is not
    # missed. The user unit bounds this startup-only wait to 30 seconds.
    bus.signal_subscribe(BUS, BUS, 'DeviceAdded', MANAGER, None, Gio.DBusSignalFlags.NONE,
                         lambda _c, _s, _p, _i, _n, params: consider(params.unpack()[0]))
    for path in call(MANAGER, BUS, 'GetDevicesByKind', GLib.Variant('(s)', ('display',)), '(ao)')[0]:
        consider(path)
    if not state['done']:
        print('Waiting for the session DSI-1 colord device', flush=True)
        loop.run()
    return state['result']


if __name__ == '__main__':
    sys.exit(main())
