"""Give an unconfigured Piano DSI panel the distribution's standard sRGB profile."""
import os
from pathlib import Path
import sys

SRGB = '/usr/share/color/icc/colord/sRGB.icc'


def unconfigured_panel(device):
    # A disabled/inhibited device can have no *default* while still containing
    # user profiles. Never replace that choice or enable color management.
    return (device.get_owner() == os.getuid()
            and device.get_embedded()
            and device.get_metadata_item('XRANDR_name') == 'DSI-1'
            and device.get_enabled()
            and not device.get_profiling_inhibitors()
            and not device.get_profiles()
            and device.get_default_profile() is None)


def main():
    if ('GNOME' not in os.environ.get('XDG_CURRENT_DESKTOP', '').split(':')
            or os.environ.get('XDG_SESSION_TYPE') != 'wayland'):
        return 0
    compatible = Path('/sys/firmware/devicetree/base/compatible')
    if not compatible.exists() or b'xiaomi,piano' not in compatible.read_bytes().split(b'\0'):
        return 0

    import gi
    gi.require_version('Colord', '1.0')
    from gi.repository import Colord, GLib

    client = Colord.Client.new()
    loop = GLib.MainLoop()
    completed = False
    result = 0

    def consider(_client, device):
        nonlocal completed, result
        if completed:
            return
        try:
            device.connect_sync(None)
            if (device.get_kind() != Colord.DeviceKind.DISPLAY
                    or device.get_owner() != os.getuid()
                    or not device.get_embedded()
                    or device.get_metadata_item('XRANDR_name') != 'DSI-1'):
                return
            if unconfigured_panel(device):
                if not Path(SRGB).is_file():
                    raise RuntimeError(f'distribution sRGB profile missing: {SRGB}')
                profile = client.find_profile_by_filename_sync(SRGB, None)
                profile.connect_sync(None)
                if profile.get_filename() != SRGB:
                    raise RuntimeError('colord returned a different profile file')
                # Refresh after profile lookup. Soft associations rank below
                # user/system hard associations, including concurrent choices.
                fresh = Colord.Device.new_with_object_path(device.get_object_path())
                fresh.connect_sync(None)
                if unconfigured_panel(fresh):
                    fresh.add_profile_sync(Colord.DeviceRelation.SOFT, profile, None)
                    print('DSI-1: associated distribution sRGB (soft)', flush=True)
                else:
                    print('DSI-1: preserved changed color configuration', flush=True)
            else:
                print('DSI-1: preserved existing color configuration', flush=True)
        except (GLib.Error, OSError, RuntimeError) as error:
            print(f'panel-srgb: {error}', file=sys.stderr, flush=True)
            result = 1
        completed = True
        loop.quit()

    # Subscribe before enumerating so asynchronous Mutter device creation is
    # not missed. The user unit bounds this startup-only wait to 30 seconds.
    client.connect('device-added', consider)
    client.connect_sync(None)
    for device in client.get_devices_sync(None):
        consider(client, device)
    if not completed:
        print('Waiting for the session DSI-1 colord device', flush=True)
        loop.run()
    return result


if __name__ == '__main__':
    sys.exit(main())
