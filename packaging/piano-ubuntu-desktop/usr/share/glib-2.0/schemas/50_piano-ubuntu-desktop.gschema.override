# Enable the GNOME Shell 50 on-screen keyboard guard for every account,
# including the GDM and initial-setup sessions, whose dconf profiles read
# these vendor defaults. The lock screen (unlock-dialog mode) loads only
# extensions listed here, not the Ubuntu session's mode extensions.
# Remove with the extension once gnome-shell >= 51 or an Ubuntu gnome-shell
# that guards maybeHandleEvent() is installed.
[org.gnome.shell]
enabled-extensions=['piano-osk-guard@io.github.piano']

[org.gnome.settings-daemon.plugins.power]
power-button-action='lock'
