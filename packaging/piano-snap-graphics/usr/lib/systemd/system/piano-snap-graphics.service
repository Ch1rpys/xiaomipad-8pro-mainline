# SPDX-License-Identifier: MIT
[Unit]
Description=Install piano Mesa and connect gpu-2404 snap consumers
Requires=snapd.seeded.service
After=snapd.seeded.service piano-firefox-snap-remove.service
ConditionPathExists=!/var/lib/piano/snap-graphics-configured

[Service]
Type=oneshot
ExecStart=/usr/bin/piano-snap-graphics-connect --install
TimeoutStartSec=5min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
