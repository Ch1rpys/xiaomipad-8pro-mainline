"""systemd integration: readiness, immutable seed -> state, HexagonFS view."""
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import shutil
import stat
import sys

from qrtr import lookup

# ADSP fatal error raised by the sensor service watchdog, for example
# "qcom_q6v5_pas 6800000.remoteproc: fatal error received: err_qdi.c:1215:EF:qsh_process:0x4:
# UTIMER_CLIENT_4:0x1000002f:sns_watchdog.c:84:thread idx 1 exceeded processing time-limit".
# After the first one the ADSP can keep failing with watchdog bites ("SFR Init") instead.
SENSOR_WATCHDOG = re.compile(rb'fatal error received: .*(?:qsh_process|sns_watchdog)')
ADSP_CRASH = re.compile(rb'crash detected in adsp:')
QUARANTINE_AFTER = 3
QUARANTINE_KEEP = 3
QUARANTINE_BOOT = 'quarantine.boot_id'


def adsp_crashes(kmsg):
    """Count this boot's ADSP crashes and sensor watchdog fatal errors in /dev/kmsg."""
    crashes = sensor = 0
    fd = os.open(kmsg, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        while True:
            try:
                record = os.read(fd, 8192)
            except BlockingIOError:
                break
            except BrokenPipeError:
                continue  # older records were overwritten; reading resumes at the oldest kept one
            if not record:
                break
            for line in record.splitlines():
                crashes += bool(ADSP_CRASH.search(line))
                sensor += bool(SENSOR_WATCHDOG.search(line))
    finally:
        os.close(fd)
    return crashes, sensor


def quarantine_registry(state, crashes, sensor, boot_id, now):
    """Move the registry state aside after repeated ADSP crashes started by the sensor
    watchdog: at least QUARANTINE_AFTER crashes, at least one with its fatal error.
    At most once per boot.

    The ADSP restarts after each crash and this service runs again, so the current boot's
    kernel log is enough. The moved state is kept for diagnosis; only the oldest of more
    than QUARANTINE_KEEP copies is removed.
    """
    live = state / 'registry'
    marker = state / QUARANTINE_BOOT
    if crashes < QUARANTINE_AFTER or not sensor or live.is_symlink() or not live.is_dir():
        return None
    boot = boot_id.read_text().strip()
    if marker.is_file() and marker.read_text().strip() == boot:
        return None
    target = state / ('registry.quarantine-' + now.strftime('%Y%m%dT%H%M%SZ'))
    # Record the boot first: a failed move must not turn into one move per ADSP restart.
    marker.write_text(boot + '\n')
    live.rename(target)
    kept = sorted(path for path in state.glob('registry.quarantine-*')
                  if path.is_dir() and not path.is_symlink())
    for path in kept[:-QUARANTINE_KEEP]:
        shutil.rmtree(path)
    return target


def seed_registry(share, state):
    dest = state / 'registry'
    if dest.is_symlink():
        raise ValueError('registry state must not be a symlink')
    if dest.exists():
        if not (dest / 'registry').is_dir():
            raise ValueError('incomplete registry state; preserve it for diagnosis')
        return 'existing-state'
    private = share / 'registry-private'
    source = private if private.exists() else share / 'registry'
    if source.is_symlink() or not (source / 'registry').is_dir():
        raise ValueError('invalid pristine registry tree')
    for path in source.rglob('*'):
        if not (stat.S_ISREG(path.lstat().st_mode) or stat.S_ISDIR(path.lstat().st_mode)):
            raise ValueError('pristine registry contains link/special file')
    # Rename only the completed copy. Interrupted copies never become live state.
    tmp = state / 'registry.new'
    if tmp.exists():
        shutil.rmtree(tmp)
    shutil.copytree(source, tmp)
    for path in tmp.rglob('*'):
        path.chmod(0o700 if path.is_dir() else 0o600)
    tmp.chmod(0o700)
    tmp.rename(dest)
    return 'private-calibration' if source == private else 'stock-default-calibration'


def prepare_view(share, runtime, socinfo):
    root = runtime / 'hexagonfs'
    root.mkdir()
    sensors = root / 'sensors'
    sensors.mkdir()
    for name in ('odm', 'vendor'):
        (sensors / name).symlink_to(share / name, target_is_directory=True)
    (sensors / 'config').symlink_to(share / 'vendor/config', target_is_directory=True)
    (sensors / 'sns_reg.conf').symlink_to(share / 'vendor/sns_reg_config')
    (root / 'socinfo').mkdir()
    for name in ('soc_id', 'revision', 'machine', 'family', 'platform_subtype',
                 'platform_subtype_id', 'platform_version', 'hw_platform'):
        path = socinfo / name
        if path.is_file():
            (root / 'socinfo' / name).write_bytes(path.read_bytes())
    # The validated v4 sensor PD uses its loaded ADSP image, no host DSP .so.
    (root / 'dsp/adsp').mkdir(parents=True)
    (root / 'acdb').mkdir()


def main():
    compatible = Path('/sys/firmware/devicetree/base/compatible').read_bytes().split(b'\0')
    if b'xiaomi,piano' not in compatible:
        raise RuntimeError('piano device tree required')
    dev = Path('/dev/fastrpc-adsp-secure')
    if not dev.is_char_device():
        raise RuntimeError('secure ADSP FastRPC character device missing')
    # This kernel's misc device has no parent link. Identify ADSP from the
    # remoteproc platform DT compatible rather than assuming remoteproc0.
    rprocs = []
    for rproc in Path('/sys/class/remoteproc').glob('remoteproc*'):
        compatible = rproc / 'device/of_node/compatible'
        if compatible.is_file() and b'qcom,sm8750-adsp-pas' in compatible.read_bytes().split(b'\0'):
            rprocs.append(rproc)
    if len(rprocs) != 1 or (rprocs[0] / 'state').read_text().strip() != 'running':
        raise RuntimeError('piano ADSP remoteproc is not running')
    services = lookup(seconds=5, wait_for_service=True)
    if not services:
        raise RuntimeError('SSC QRTR service 400 unavailable after 5 seconds')
    print('SSC_QRTR_400=' + json.dumps(services), flush=True)
    share = Path('/usr/share/piano/sensors')
    state = Path(os.environ['STATE_DIRECTORY'])
    try:
        crashes, sensor = adsp_crashes('/dev/kmsg')
    except OSError as error:
        print(f'piano-sensors: kernel log unreadable, registry check skipped: {error}', file=sys.stderr, flush=True)
        crashes = sensor = 0
    moved = quarantine_registry(state, crashes, sensor, Path('/proc/sys/kernel/random/boot_id'),
                                datetime.now(timezone.utc))
    if moved:
        print(f'piano-sensors: {crashes} ADSP crashes in this boot, {sensor} of them fatal errors from the sensor '
              f'watchdog (qsh_process/sns_watchdog); moved the sensor registry to {moved} and seeding it again',
              flush=True)
    calibration = seed_registry(share, state)
    print('SSC_REGISTRY=' + calibration, flush=True)
    if calibration == 'stock-default-calibration':
        print('No private factory calibration; using ODM defaults. Accuracy is unverified.', flush=True)
    prepare_view(share, Path(os.environ['RUNTIME_DIRECTORY']), Path('/sys/devices/soc0'))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError) as error:
        print('piano-sensors: ' + str(error), file=sys.stderr)
        sys.exit(1)
