# SPDX-License-Identifier: MIT
# This board package is for piano. Use only its secure ADSP sensor endpoint;
# do not expose compass/proximity (not GNOME product acceptance targets yet).
ACTION=="remove", GOTO="piano_sensors_end"
SUBSYSTEM!="misc", GOTO="piano_sensors_end"
KERNEL=="fastrpc-adsp*", ENV{IIO_SENSOR_PROXY_TYPE}=""
KERNEL=="fastrpc-sdsp*", ENV{IIO_SENSOR_PROXY_TYPE}=""
# SSC -> landscape-native display: (X,Y,Z)=(y,-x,z). Docked +x -> normal.
# Do not repeat the Android registry orientation here. Left/right still needs
# the physical four-edge test documented in device/sensors/README.zh-CN.md.
KERNEL=="fastrpc-adsp-secure", ENV{IIO_SENSOR_PROXY_TYPE}="ssc-accel ssc-light", ENV{ACCEL_MOUNT_MATRIX}="0, 1, 0; -1, 0, 0; 0, 0, 1", ENV{ACCEL_LOCATION}="display", TAG+="systemd", ENV{SYSTEMD_WANTS}+="piano-hexagonrpcd-sns.service iio-sensor-proxy.service"
LABEL="piano_sensors_end"
