#!/bin/sh
# SPDX-License-Identifier: MIT
# Read-only diagnostics after a normal boot. Run as the desktop user, not root.
# sudo is used only for input-device inspection; never grab/read key events.
set -u
case "${1-}" in
    --help|-h)
        echo 'Usage: piano-sensors-check [--orientations]'
        echo 'Run as the active GNOME user; --orientations prompts for dock/undock and four edges.'
        exit 0 ;;
    '') interactive=no ;;
    --orientations) interactive=yes ;;
    *) echo 'Usage: piano-sensors-check [--orientations]' >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || exit 2
if [ "$(id -u)" -eq 0 ]; then
    echo 'Run as the active GNOME user, without sudo; input inspection requests sudo separately.' >&2
    exit 2
fi
if [ "$interactive" = yes ] && [ ! -t 0 ]; then
    echo '--orientations requires an interactive terminal on stdin.' >&2
    exit 2
fi
result=0
# Also works over SSH as the SAME user as the active graphical session.
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
sudo -v || exit 1

input_state() {
    sudo python3 - <<'PY'
import fcntl
from pathlib import Path
import subprocess
import sys

failed = False
for event in sorted(Path('/sys/class/input').glob('event*')):
    name = (event / 'device/name').read_text().strip()
    props = subprocess.check_output(['udevadm', 'info', '--query=property', '--path', str(event)], text=True)
    selected = [line for line in props.splitlines()
                if line.startswith(('ID_INPUT', 'ID_SEAT=', 'WL_SEAT=', 'LIBINPUT_IGNORE_DEVICE='))]
    print(f'{event.name}: {name}', flush=True)
    print('\n'.join(selected) or '(no input classification)', flush=True)
    try:
        with open('/dev/input/' + event.name, 'rb', buffering=0) as fd:
            # Linux generic ioctl ABI, including arm64: EVIOCGBIT(EV_SW, 8), EVIOCGSW(8).
            caps = bytearray(8)
            fcntl.ioctl(fd, 0x80084525, caps, True)
            if int.from_bytes(caps, sys.byteorder) & (1 << 1):
                state = bytearray(8)
                fcntl.ioctl(fd, 0x8008451b, state, True)
                print('SW_TABLET_MODE=' + str((int.from_bytes(state, sys.byteorder) >> 1) & 1), flush=True)
    except OSError as error:
        failed = True
        print(f'INPUT_READ_ERROR: {error}', flush=True)
sys.exit(1 if failed else 0)
PY
}

snapshot() {
    printf '\n=== %s ===\n' "$1"
    date --iso-8601=seconds
    input_state || result=1
    printf '\nPanelOrientationManaged: '
    busctl --user get-property org.gnome.Mutter.DisplayConfig /org/gnome/Mutter/DisplayConfig org.gnome.Mutter.DisplayConfig PanelOrientationManaged || result=1
    printf '\norientation-lock: '
    gsettings get org.gnome.settings-daemon.peripherals.touchscreen orientation-lock || result=1
    printf '\nmonitor-sensor --accel (5 seconds; claims sensor even while docked):\n'
    rc=0
    timeout --signal=TERM --kill-after=2s 5s stdbuf -oL -eL monitor-sensor --accel || rc=$?
    case "$rc" in 0|124) ;; *) result=1 ;; esac
    for property in HasAccelerometer AccelerometerOrientation HasAmbientLight LightLevel LightLevelUnit; do
        printf '\n%s: ' "$property"
        busctl --system get-property net.hadess.SensorProxy /net/hadess/SensorProxy net.hadess.SensorProxy "$property" || result=1
    done
    printf '\nMutter current state (logical transform: normal=0, left-up=1, bottom-up=2, right-up=3):\n'
    busctl --user call org.gnome.Mutter.DisplayConfig /org/gnome/Mutter/DisplayConfig org.gnome.Mutter.DisplayConfig GetCurrentState || result=1
}

prompt() {
    printf '\n%s\nPress Enter when ready: ' "$1"
    IFS= read -r answer || exit 1
}

printf 'Boot ID: '
cat /proc/sys/kernel/random/boot_id
uname -r
dpkg-query -W -f='${binary:Package}\t${Version}\n' 'mutter*' 'libmutter*' gnome-shell libinput10 udev piano-sensors piano-iio-sensor-proxy
loginctl show-seat seat0 -p ActiveSession -p Sessions
session=$(loginctl show-seat seat0 -p ActiveSession --value)
if [ -z "$session" ]; then
    echo 'No active seat0 session.' >&2
    exit 1
fi
loginctl show-session "$session" -p Name -p User -p Active -p Type -p State -p Remote
if [ "$(loginctl show-session "$session" -p User --value)" != "$(id -u)" ] ||
   [ "$(loginctl show-session "$session" -p Type --value)" != wayland ]; then
    echo 'Run as the user of the active seat0 Wayland session.' >&2
    exit 1
fi
systemctl --no-pager --full status piano-hexagonrpcd-sns.service iio-sensor-proxy.service || result=1
printf '\nEffective sensor udev properties:\n'
udevadm info --query=property --path=/sys/class/misc/fastrpc-adsp-secure || result=1
printf '\nUPower lid properties:\n'
for property in LidIsPresent LidIsClosed; do
    busctl --system get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower "$property" || result=1
done
printf '\nlibinput device capabilities (independent context, not Mutter internal state):\n'
if command -v libinput >/dev/null; then
    sudo libinput list-devices || result=1
else
    echo 'NOT COLLECTED: install libinput-tools for libinput capabilities (udev/ioctl checks still run).'
    result=1
fi
if [ "$interactive" = yes ]; then
    prompt 'Attach keyboard dock, landscape upright. Expected: switch=0, managed=false, sensor=normal/tilted-up.'
fi
snapshot docked-or-baseline
if [ "$interactive" = yes ]; then
    echo 'Disable rotation lock in GNOME if enabled. Identify physical edges in native landscape before rotating.'
    for edge in top left bottom right; do
        case "$edge" in
            top) expected='normal, transform 0' ;;
            left) expected='left-up, transform 1' ;;
            bottom) expected='bottom-up, transform 2' ;;
            right) expected='right-up, transform 3' ;;
        esac
        prompt "Detach keyboard; hold upright with the ORIGINAL $edge edge highest. Expected: $expected; switch=1 and managed=true."
        snapshot "undocked-$edge-up"
        printf '\nCheck upright text and touch four corners. Enter observations (including any wrong rotation): '
        IFS= read -r answer || exit 1
        printf 'VISUAL_TOUCH_%s: %s\n' "$edge" "$answer"
    done
    prompt 'Return to native landscape and reattach dock. Expected switch=0, managed=false, transform 0.'
    snapshot redocked
fi
printf '\nSensor and compositor warnings since boot:\n'
sudo journalctl -b -u piano-hexagonrpcd-sns -u iio-sensor-proxy --no-pager -n 100
journalctl --user -b --no-pager -g 'accelerometer|orientation|sensor' -n 60
printf '\nReporting status=%s; this is NOT physical rotation/brightness PASS. Keep this log private.\n' "$result"
printf 'HasAmbientLight=false remains a separate unresolved discovery issue.\n'
exit "$result"
