# SPDX-License-Identifier: MIT
[Desktop Entry]
Type=Application
Name=Switch to Android
Name[zh_CN]=切换到 Android
Comment=Write the Android boot images and restart ignoring inhibitors; save your work first
Comment[zh_CN]=写入 Android 启动镜像并忽略阻止请求重启；请先保存工作
Exec=pkexec /usr/sbin/piano-boot-switch to-android --desktop --force
Icon=system-reboot
Terminal=false
StartupNotify=false
Categories=System;
Keywords=Android;reboot;dual boot;
Keywords[zh_CN]=安卓;重启;双系统;
