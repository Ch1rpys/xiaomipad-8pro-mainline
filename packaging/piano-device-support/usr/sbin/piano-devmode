#!/bin/sh
# SPDX-License-Identifier: MIT
# Turn the piano developer mode (SSH login over the USB cable) on or off and
# report its state.  The switch is the enablement state of
# piano-devmode.service: `on` is `systemctl enable --now`, `off` is
# `systemctl disable --now`.  `check` is the unit's start check: OpenSSH
# server present, host keys created, developer-mode sshd configuration valid.
set -eu
unit=piano-devmode.service
sshd=/usr/sbin/sshd
config=/usr/lib/piano/devmode/sshd_config

usage() {
	echo 'usage: piano-devmode on|off|status|check' >&2
	exit 2
}

need_sshd() {
	if [ ! -x "$sshd" ]; then
		echo "piano-devmode: OpenSSH server is not installed ($sshd is missing); install the openssh-server package, then run: piano-devmode on" >&2
		exit 1
	fi
}

debug_boot() {
	case " $(cat /proc/cmdline) " in *' piano.debug=1 '*) return 0 ;; esac
	return 1
}

# The system OpenSSH listens on every address; then the developer-mode
# socket, which listens only on the USB address, cannot bind port 22.
system_ssh_active() {
	systemctl -q is-active ssh.socket || systemctl -q is-active ssh.service
}

status() {
	# shellcheck source=/dev/null # generated from initramfs/network.json
	. /etc/piano-network
	echo "developer mode: $(systemctl is-enabled "$unit" 2>/dev/null || true), $(systemctl is-active "$unit" 2>/dev/null || true)"
	if debug_boot; then
		echo 'debug boot (piano.debug=1): developer mode does not start; piano-debug owns the USB link'
	fi
	if [ -x "$sshd" ]; then
		echo "OpenSSH server: $sshd"
	else
		echo 'OpenSSH server: not installed (openssh-server)'
	fi
	gadget=/sys/kernel/config/usb_gadget/piano-devmode
	if [ -e "$gadget/UDC" ] && [ -n "$(cat "$gadget/UDC")" ]; then
		echo "USB gadget: bound to $(cat "$gadget/UDC")"
	else
		echo 'USB gadget: not bound'
	fi
	ifname=
	for n in /sys/class/net/*; do
		if [ "$(cat "$n/address" 2>/dev/null)" = "$PIANO_DEVICE_MAC" ]; then
			ifname=${n##*/}
		fi
	done
	if [ -n "$ifname" ]; then
		echo "USB network: $ifname $(ip -4 -brief address show dev "$ifname" | sed 's/^[^ ]* *//')"
	else
		echo "USB network: no interface with $PIANO_DEVICE_MAC"
	fi
	echo "SSH socket: $(systemctl is-active piano-devmode-ssh.socket 2>/dev/null || true) ($PIANO_DEVICE_IP port 22)"
	echo "host: ssh <user>@$PIANO_DEVICE_IP (the host side gets $PIANO_HOST_IP by DHCP)"
	if system_ssh_active; then
		echo 'warning: ssh.socket or ssh.service is active and listens on every address, so the USB-only socket cannot bind; to keep SSH on the USB link only: systemctl disable --now ssh.socket ssh.service'
	fi
}

[ "$#" -eq 1 ] || usage
case "$1" in
on)
	need_sshd
	systemctl enable --now "$unit"
	if debug_boot; then
		echo 'piano-devmode: enabled; it starts with the next boot without piano.debug=1'
	fi
	status
	;;
off)
	systemctl disable --now "$unit"
	;;
status)
	status
	;;
check)
	need_sshd
	ssh-keygen -A
	if ! "$sshd" -t -f "$config"; then
		echo "piano-devmode: $sshd rejects $config or the host keys" >&2
		exit 1
	fi
	;;
*)
	usage
	;;
esac
