#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-only
"""Build and retain a coherent boot image set after the distro initrd hook.

The new set becomes /var/lib/piano/switch/ubuntu and the previous one
ubuntu.prev.  On a running persistent piano boot (devicetree xiaomi,piano and
piano.boot=persistent) `piano-boot-switch to-ubuntu --only-if-ubuntu` then
rewrites slot A in place when it holds an Ubuntu store set, so the booted
kernel and initrd keep matching the installed modules; Android in slot A is
left alone.  Anywhere else (an image-building chroot, QEMU, a RAM root) only
the store changes and no disk is inspected.

The set needs this unit's boot profile and signing key in /etc/piano, and on a
running persistent piano boot also its partition map (boot-partitions.json),
without which piano-boot-switch cannot write slot A.  A release root
filesystem ships without them and with a prepared set; until the owner
installs them, kernel hooks leave the store and slot A unchanged and succeed.
A missing map must not rotate the store either: the new set could not be
written, slot A would then hold ubuntu.prev, and the next rotation (the
documented piano-boot-update after installing the map) would delete it.  The
root is /etc/piano/layout.json's root_partlabel (a release root) or
root_partuuid; the Bluetooth and WLAN addresses are optional.

`piano-boot-update --removed RELEASE` runs after a piano kernel package is
removed: if RELEASE owned the current set, the set is rebuilt for the newest
remaining piano kernel (as flash-kernel reflashes on removal), and a rollback
set that boots RELEASE is deleted, since its modules are gone.
"""
import fcntl
import json
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


BANNER = re.compile(rb'Linux version ([0-9][A-Za-z0-9.+-]*) \(')


def set_release(directory):
    """Kernel release a store set boots: its manifest, else the boot.img banner."""
    manifest = directory / 'manifest.json'
    if manifest.is_file():
        release = json.loads(manifest.read_text()).get('kernel_release')
        if release:
            return release
    boot = directory / 'boot.img'
    match = BANNER.search(boot.read_bytes()) if boot.is_file() else None
    return match[1].decode() if match else None


def newest_piano_release(run):
    listed = run(['linux-version', 'list'], capture_output=True, text=True, check=True).stdout.split()
    piano = [r for r in listed if re.fullmatch(r'[0-9][A-Za-z0-9.]*-piano[0-9]+', r)]
    if not piano:
        return None
    return run(['linux-version', 'sort'], input='\n'.join(piano) + '\n', capture_output=True,
               text=True, check=True).stdout.split()[-1]


def removed(release, root, run):
    store = root / 'var/lib/piano/switch'
    if not store.is_dir():
        return 0
    if (store / 'ubuntu').is_dir() and set_release(store / 'ubuntu') == release:
        latest = newest_piano_release(run)
        if latest and (root / f'boot/initrd.img-{latest}').exists():
            print(f'{release} owned the boot image set; rebuilding it for {latest}')
            main(['piano-boot-update', latest], root, run)
        else:
            print(f'WARNING: {release} owned the boot image set and no piano kernel with an initrd remains; '
                  'slot A is unchanged', file=sys.stderr)
    with (store / '.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if (store / 'ubuntu.prev').is_dir() and set_release(store / 'ubuntu.prev') == release:
            shutil.rmtree(store / 'ubuntu.prev')
            print(f'Dropped the rollback set of removed kernel {release}')
    return 0


def on_persistent_piano(root):
    compatible = root / 'sys/firmware/devicetree/base/compatible'
    cmdline = root / 'proc/cmdline'
    return (compatible.is_file() and b'xiaomi,piano' in compatible.read_bytes().split(b'\0') and
            cmdline.is_file() and 'piano.boot=persistent' in cmdline.read_text().split())


def main(argv, root=Path('/'), run=subprocess.run):
    if argv[1:2] == ['--removed'] and len(argv) == 3:
        if not re.fullmatch(r'[0-9][A-Za-z0-9.+-]*-piano[A-Za-z0-9.+-]*', argv[2]):
            raise SystemExit('Not a piano kernel release')
        return removed(argv[2], root, run)
    release = argv[1] if len(argv) > 1 else ''
    if not re.fullmatch(r'[0-9][A-Za-z0-9.+-]*-piano[A-Za-z0-9.+-]*', release):
        raise SystemExit('Not a piano kernel release')
    config = root / 'etc/piano'
    layout = json.loads((config / 'layout.json').read_text())
    if 'root_partlabel' in layout:
        root_option = ['--root-partlabel', layout['root_partlabel']]
    else:
        root_option = ['--root-partuuid', layout['root_partuuid']]
    persistent = on_persistent_piano(root)
    needed = ('boot-profile.json', 'boot-signing.pem') + (('boot-partitions.json',) if persistent else ())
    missing = [n for n in needed if not (config / n).is_file()]
    if missing:
        print(f'Boot image set not rebuilt for {release}: /etc/piano/{" and /etc/piano/".join(missing)} '
              'of this unit not installed; the store and slot A are unchanged. Install '
              f'{"them" if len(missing) > 1 else "it"}, then run: piano-boot-update {release}')
        return 0
    store = root / 'var/lib/piano/switch'
    store.mkdir(parents=True, exist_ok=True)
    tools = root / 'usr/lib/piano/boot'
    with (store / '.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with tempfile.TemporaryDirectory(prefix='.build-', dir=store) as tmp:
            output = Path(tmp) / 'images'
            # Both addresses are optional. Without the WLAN address ath12k keeps the card's
            # (all-zero on piano); without the Bluetooth address hci_qca leaves the
            # controller unconfigured.
            wlan = config / 'wlan-address'
            bt = config / 'bluetooth-address'
            run([
                'python3', str(tools / 'build-persistent-boot.py'),
                '--kernel', str(root / f'boot/vmlinuz-{release}'), '--kernel-release', release,
                '--dtb', str(root / f'usr/lib/linux-image-{release}/piano-boot.dtb'),
                '--initrd', str(root / f'boot/initrd.img-{release}'),
                '--profile', str(config / 'boot-profile.json'), *root_option,
                '--mkbootimg', str(tools / 'mkbootimg.py'),
                '--avbtool', str(tools / 'avbtool.py'),
                '--key', str(config / 'boot-signing.pem'), '--output', str(output)
            ] + (['--bt-address-file', str(bt)] if bt.is_file() else [])
              + (['--wlan-address-file', str(wlan)] if wlan.is_file() else []), check=True)
            if (store / 'ubuntu.prev').exists():
                shutil.rmtree(store / 'ubuntu.prev')
            if (store / 'ubuntu').exists():
                (store / 'ubuntu').rename(store / 'ubuntu.prev')
            output.rename(store / 'ubuntu')
    print(f'Piano boot image set prepared for {release}')
    if not persistent:
        print('Slot A not inspected: not a running persistent piano boot')
        return 0
    # The store lock is released: the switch takes it together with the device lock.
    result = run([str(root / 'usr/sbin/piano-boot-switch'), 'to-ubuntu', '--only-if-ubuntu'])
    if result.returncode:
        raise SystemExit(f'piano-boot-switch to-ubuntu failed (exit {result.returncode}); the new set is in '
                         f'{store}/ubuntu, see `piano-boot-switch status`')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
