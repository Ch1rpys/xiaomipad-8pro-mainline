#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
# Without a console the kernel reports "unable to open an initial console" and
# starts PID 1 with fds 0-2 closed; the first write then fails and set -e ends
# PID 1. Like systemd's make_console_stdio(), use /dev/console when it opens and
# /dev/null otherwise. The probe opens read-first so neither node is created.
if (exec </dev/console >/dev/console) 2>/dev/null; then
	exec </dev/console >/dev/console 2>&1
else
	exec </dev/null >/dev/null 2>&1
fi
mkdir -p /proc /sys
[ -r /proc/self/mounts ] || mount -t proc -o nosuid,nodev,noexec proc /proc
[ -d /sys/kernel ] || mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
/usr/libexec/piano/piano-physical-platform /sys
exec /usr/lib/systemd/systemd "$@"
