# SPDX-License-Identifier: MIT
# SSH listener of the developer mode on the USB NCM device address only
# (device_ip of initramfs/network.json).  FreeBind lets it listen before
# systemd-networkd has configured that address.  BindToDevice restricts it to
# the NCM interface, the first gadget Ethernet device, usb0: the address alone
# would also accept connections that reach it over Wi-Fi, as Linux accepts a
# local address on any interface.  systemd starts the socket once usb0
# exists.  Started and stopped with piano-devmode.service; it has no
# [Install] section of its own.  It cannot bind while the system ssh.socket
# or ssh.service listens on every address.
[Unit]
Description=Piano developer mode SSH socket (USB network only)
BindsTo=piano-devmode.service

[Socket]
ListenStream=192.168.88.2:22
FreeBind=yes
BindToDevice=usb0
Accept=yes
