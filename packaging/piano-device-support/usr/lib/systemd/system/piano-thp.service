[Unit]
Description=Piano touchscreen input processing
# Started only by udev (71-piano.rules SYSTEMD_WANTS) once the touch node exists.
# There is no [Install] section: a boot target that wanted this unit would wait
# DefaultDeviceTimeoutSec for a node that a kernel or DT variant never creates.
BindsTo=dev-piano\x2dtouch.device
After=dev-piano\x2dtouch.device
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/libexec/piano/piano-thp-live /etc/piano/thp-calibration.json /dev/piano-touch
Restart=on-failure
RestartSec=1
# The touch stream can stay unavailable for several seconds after a display
# or session transition, then start normally without a panel power cycle.
# Grow the delay instead of letting the default start limit (5 starts in
# 10 s) give up inside that window: about 1, 2, 4, 8, 15, then every 30 s.
RestartSteps=5
RestartMaxDelaySec=30
