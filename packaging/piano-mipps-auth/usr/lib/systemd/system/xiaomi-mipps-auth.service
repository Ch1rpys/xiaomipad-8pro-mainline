# SPDX-License-Identifier: MIT
[Unit]
Description=Xiaomi MiPPS adapter authentication
Requires=piano-charging.service
After=piano-charging.service
ConditionPathExists=/sys/class/power_supply/xiaomi-mca-usb/xiaomi/request_vdm_cmd

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n -E 0 /run/xiaomi-mipps-auth.lock /usr/libexec/xiaomi-mipps-auth --timeout 4
ExecStopPost=/bin/sh -ec 'echo 0 > /sys/class/power_supply/xiaomi-mca-usb/xiaomi/verify_process'
TimeoutStartSec=20
