From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Subject: [PATCH] hexagonrpcd: implement apps_std frename in the writable registry

The sensor PD stores each registry group by writing registry/fstempfile and
calling apps_std method 33, frename(oldname, newname) (extended method ID,
three input buffers; Qualcomm fastrpc v1.0.7 apps_std.h and apps_std_skel.c
case 33, whose implementation is rename(2)). hexagonrpcd answered it as
unsupported, about 110 times per attach on piano, so the DSP's registry
updates were lost and fstempfile stayed behind.

Implement it with rename(2) semantics: an existing target is replaced
atomically. Both names are resolved with the existing mapping rules, and
both resulting directories must belong to the explicit -w registry copy;
"..", absolute paths and the read-only mappings outside it are refused, as
are links followed out of it. Source and an existing target must be regular
files with a single link; directories, symlinks and hard links are never
moved or replaced. The source data is synced before the rename and both
directories after it, so a completed rename survives a power loss.

Tests cover a rename, replacing a target (an open reader keeps the old
bytes), spellings through ".." that stay inside, a missing source, escapes,
read-only mappings, links, directories and unterminated names. The stock
replay can additionally store a stock persist registry the same way and
then requires the scratch copy to equal it byte for byte, with no
fstempfile left. Drop this patch when upstream implements frename with the
same confinement.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
diff --git a/hexagonrpcd/apps_std.c b/hexagonrpcd/apps_std.c
index 1939523..0c97ec6 100644
--- a/hexagonrpcd/apps_std.c
+++ b/hexagonrpcd/apps_std.c
@@ -272,6 +272,27 @@ static uint32_t apps_std_fremove(void *data,
 	return ret < 0 ? AEE_EFAILED : AEE_SUCCESS;
 }
 
+static uint32_t apps_std_frename(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *oldname = inbufs[1].p, *newname = inbufs[2].p;
+	int ret;
+	(void)outbufs;
+	if (!inbufs[1].s || oldname[inbufs[1].s - 1] || !inbufs[2].s || newname[inbufs[2].s - 1])
+		return AEE_EBADPARM;
+	ret = hexagonfs_renameat(ctx->fds, ctx->rootfd, ctx->adsp_library_dirfd, oldname, newname);
+#ifdef HEXAGONRPC_VERBOSE
+	printf("rename(%s, %s) -> %d\n", oldname, newname, ret);
+#endif
+	if (ret < 0) {
+		fprintf(stderr, "Could not rename %s to %s: %s\n", oldname, newname, strerror(-ret));
+		return AEE_EFAILED;
+	}
+	return AEE_SUCCESS;
+}
+
 static uint32_t apps_std_opendir(void *data,
 				 const struct fastrpc_io_buffer *inbufs,
 				 struct fastrpc_io_buffer *outbufs)
@@ -529,10 +550,12 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_stat_def,
 		.impl = apps_std_stat,
 	},
+	{ .def = NULL, .impl = NULL, },
+	{ .def = &apps_std_frename_def, .impl = apps_std_frename, },
 };
 
 const struct fastrpc_interface apps_std_interface = {
 	.name = "apps_std",
-	.n_procs = 32,
+	.n_procs = 34,
 	.procs = apps_std_procs,
 };
diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index 93aa48c..77bb619 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -220,6 +220,38 @@ ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, cons
 	return fds[fileno]->ops->write(fds[fileno], size, ptr);
 }
 
+/*
+ * Resolve the directory holding the last segment of PATH with the normal
+ * mapping rules (absolute from the root, otherwise from DIRFD; ".." stays in
+ * the virtual tree). PATH is split in place and *LEAF points to the segment.
+ */
+static int open_parent(struct hexagonfs_fd **fds, int rootfd, int dirfd, char *path, char **leaf)
+{
+	*leaf = strrchr(path, '/');
+	if (!*leaf) {
+		*leaf = path;
+		return dirfd;
+	}
+	*(*leaf)++ = '\0';
+	return hexagonfs_openat(fds, rootfd, dirfd, *path ? path : "/");
+}
+
+static void close_parent(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+			 const char *path, const char *leaf, int parent)
+{
+	if (leaf != path && parent >= 0 && parent != dirfd && parent != rootfd)
+		hexagonfs_close(fds, parent);
+}
+
+static int check_parent(struct hexagonfs_fd **fds, const char *leaf, int parent)
+{
+	if (!*leaf || !strcmp(leaf, ".") || !strcmp(leaf, ".."))
+		return -EINVAL;
+	if (parent < 0 || parent >= HEXAGONFS_MAX_FD || !fds[parent])
+		return parent < 0 ? parent : -EBADF;
+	return 0;
+}
+
 int hexagonfs_removeat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
 {
 	char *path = strdup(name), *leaf;
@@ -227,28 +259,53 @@ int hexagonfs_removeat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const c
 	struct hexagonfs_fd *dir;
 	if (!path)
 		return -ENOMEM;
-	leaf = strrchr(path, '/');
-	if (leaf) {
-		*leaf++ = '\0';
-		parent = hexagonfs_openat(fds, rootfd, dirfd, *path ? path : "/");
-	} else {
-		leaf = path;
-		parent = dirfd;
-	}
-	if (!*leaf || !strcmp(leaf, ".") || !strcmp(leaf, ".."))
-		ret = -EINVAL;
-	else if (parent < 0 || parent >= HEXAGONFS_MAX_FD || !fds[parent])
-		ret = parent < 0 ? parent : -EBADF;
-	else {
+	parent = open_parent(fds, rootfd, dirfd, path, &leaf);
+	ret = check_parent(fds, leaf, parent);
+	if (!ret) {
 		dir = fds[parent];
 		ret = dir->ops->removeat ? dir->ops->removeat(dir, leaf) : -EROFS;
 	}
-	if (leaf != path && parent >= 0 && parent != dirfd && parent != rootfd)
-		hexagonfs_close(fds, parent);
+	close_parent(fds, rootfd, dirfd, path, leaf, parent);
 	free(path);
 	return ret;
 }
 
+/*
+ * Both names are resolved like removeat. Only directories whose ops share one
+ * renameat implementation (the explicitly writable registry copy) can take part;
+ * every other mapping, including what ".." escapes reach, is read-only.
+ */
+int hexagonfs_renameat(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		       const char *oldname, const char *newname)
+{
+	char *oldpath = strdup(oldname), *newpath = strdup(newname), *oldleaf, *newleaf;
+	int oldparent, newparent, ret;
+	struct hexagonfs_fd *olddir, *newdir;
+	if (!oldpath || !newpath) {
+		free(oldpath);
+		free(newpath);
+		return -ENOMEM;
+	}
+	oldparent = open_parent(fds, rootfd, dirfd, oldpath, &oldleaf);
+	newparent = open_parent(fds, rootfd, dirfd, newpath, &newleaf);
+	ret = check_parent(fds, oldleaf, oldparent);
+	if (!ret)
+		ret = check_parent(fds, newleaf, newparent);
+	if (!ret) {
+		olddir = fds[oldparent];
+		newdir = fds[newparent];
+		if (!olddir->ops->renameat || olddir->ops->renameat != newdir->ops->renameat)
+			ret = -EROFS;
+		else
+			ret = olddir->ops->renameat(olddir, oldleaf, newdir, newleaf);
+	}
+	close_parent(fds, rootfd, dirfd, newpath, newleaf, newparent);
+	close_parent(fds, rootfd, dirfd, oldpath, oldleaf, oldparent);
+	free(newpath);
+	free(oldpath);
+	return ret;
+}
+
 int hexagonfs_close(struct hexagonfs_fd **fds, int fileno)
 {
 	struct hexagonfs_fd *fd;
