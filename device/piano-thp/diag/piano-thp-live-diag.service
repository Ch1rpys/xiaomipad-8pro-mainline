# SPDX-License-Identifier: MIT
# RAM-only supervised diagnostic for one bounded session; not a product service.
# Started explicitly by the host orchestrator; there is deliberately no [Install].
[Unit]
Description=Piano THP live touch diagnostic (RAM only, not a product service)

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/local/libexec/piano/piano-thp-live-diag /usr/local/libexec/piano/thp-calibration.json
Restart=no
KillMode=mixed
TimeoutStopSec=10s
