#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# RAM-only subset of erhai init-ncm: see NOTICE. No persistent mounts.
set -eu
export PATH=/bin
bb=/bin/busybox
. /etc/piano-network
url=$1
expected=$2
seconds=$3
transport=$4
case "$expected" in *[!0-9a-f]*|'') exit 2 ;; esac
[ "${#expected}" -eq 64 ]
case "$seconds" in *[!0-9]*|'') exit 2 ;; esac
[ "$seconds" -ge 60 ] && [ "$seconds" -le 900 ]

case "$transport:$url" in
http:"http://$PIANO_HOST_IP:"*/ubuntu.squashfs)
	echo 'PIANO_UBUNTU_DOWNLOAD'
	$bb wget -T 60 -O /run/ubuntu.squashfs "$url"
	printf '%s  %s\n' "$expected" /run/ubuntu.squashfs | $bb sha256sum -c -
	echo 'PIANO_UBUNTU_ROOT_VERIFIED'
	root_source=/run/ubuntu.squashfs
	;;
nbd:"nbd://$PIANO_HOST_IP:"*)
	port=${url##*:}
	case "$port" in *[!0-9]*|'') exit 2 ;; esac
	$bb nbd-client -N "$expected" -t 60 "$PIANO_HOST_IP" "$port" /dev/nbd0
	[ "$(cat /sys/class/block/nbd0/ro)" = 1 ]
	echo "PIANO_UBUNTU_NBD_READY: host-verified export=$expected readonly=1"
	root_source=/dev/nbd0
	;;
*) exit 2 ;;
esac
mkdir -p /run/ubuntu-lower /run/ubuntu-upper /run/ubuntu-work /newroot
mount -t squashfs -o loop,ro "$root_source" /run/ubuntu-lower
mount -t overlay overlay -o lowerdir=/run/ubuntu-lower,upperdir=/run/ubuntu-upper,workdir=/run/ubuntu-work /newroot
[ -x /newroot/usr/lib/systemd/systemd ]
mkdir -p /newroot/etc/cloud /newroot/etc/systemd/network /newroot/etc/NetworkManager/conf.d \
	/newroot/etc/systemd/system/sysinit.target.wants /newroot/etc/systemd/system/multi-user.target.wants \
	/newroot/usr/local/libexec/piano
touch /newroot/etc/cloud/cloud-init.disabled
$bb rm -f /newroot/etc/apt/sources.list.d/cdrom.sources
# Private firmware from build-initramfs.sh FIRMWARE_DIR: drivers that request it
# after the switch (for example on the first open of a DRM node) read the root.
if [ -f /etc/piano-firmware ]; then
	while read -r rel _; do
		$bb mkdir -p "$($bb dirname "/newroot/usr/lib/firmware/$rel")"
		$bb cp "/lib/firmware/$rel" "/newroot/usr/lib/firmware/$rel"
	done </etc/piano-firmware
	$bb awk '{ print $3 "  /newroot/usr/lib/firmware/" $1 }' /etc/piano-firmware | $bb sha256sum -c -s -
	$bb cp /etc/piano-firmware /newroot/etc/piano-firmware
	echo "PIANO_FIRMWARE_INSTALLED files=$($bb wc -l </etc/piano-firmware) manifest=$($bb sha256sum /etc/piano-firmware | $bb cut -d' ' -f1)"
fi
# Retain matching modules and explicit-load policy across the RAM root switch.
if [ -f /etc/piano-modules.json ]; then
	/bin/piano-modules copy /newroot
fi
$bb cp /etc/build-id /run/piano-build-id
$bb cp /etc/piano-network /run/piano-network
$bb cp "$bb" /newroot/usr/local/libexec/piano/busybox
$bb cp /bin/ubuntu-state /newroot/usr/local/libexec/piano-ubuntu-state

cat > /newroot/etc/systemd/network/10-piano-ram.link <<EOF
[Match]
MACAddress=$PIANO_DEVICE_MAC
[Link]
Name=usb0
EOF
cat > /newroot/etc/NetworkManager/conf.d/99-piano-ram.conf <<EOF
[keyfile]
unmanaged-devices=interface-name:usb0
EOF
cat > /newroot/usr/local/libexec/piano-ram-console <<'EOF'
#!/bin/sh
printf 'PIANO_UBUNTU_CONSOLE %s\n' "$(cat /run/piano-build-id)"
export PS1='# '
exec /usr/local/libexec/piano/busybox sh
EOF
$bb chmod 0755 /newroot/usr/local/libexec/piano-ram-console
cat > /newroot/etc/systemd/system/piano-ram-console.service <<EOF
[Unit]
Description=Piano temporary RAM USB console
DefaultDependencies=no
[Service]
Type=simple
ExecStart=/usr/local/libexec/piano/busybox telnetd -F -b $PIANO_DEVICE_IP:2323 -l /usr/local/libexec/piano-ram-console
[Install]
WantedBy=sysinit.target
EOF
ln -s ../piano-ram-console.service /newroot/etc/systemd/system/sysinit.target.wants/piano-ram-console.service

now=$($bb cut -d. -f1 /proc/uptime)
cat > /newroot/etc/systemd/system/piano-ram-expiry.service <<'EOF'
[Unit]
Description=End the temporary piano RAM session
DefaultDependencies=no
[Service]
Type=oneshot
ExecStart=/usr/local/libexec/piano/busybox reboot -f
EOF
cat > /newroot/etc/systemd/system/piano-ram-expiry.timer <<EOF
[Unit]
Description=Bound the piano RAM Ubuntu session
DefaultDependencies=no
[Timer]
OnBootSec=$((now + seconds))s
AccuracySec=1s
[Install]
WantedBy=sysinit.target
EOF
ln -s ../piano-ram-expiry.timer /newroot/etc/systemd/system/sysinit.target.wants/piano-ram-expiry.timer
echo "PIANO_UBUNTU_PREPARED expiry=$((now + seconds))"
