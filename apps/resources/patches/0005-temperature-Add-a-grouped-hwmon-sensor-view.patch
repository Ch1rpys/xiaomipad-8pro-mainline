+glib::wrapper! {
+    pub struct ResTemperatures(ObjectSubclass<imp::ResTemperatures>)
+        @extends gtk::Widget, adw::Bin,
+        @implements gtk::Buildable, gtk::ConstraintTarget, gtk::Accessible;
+}
+
+impl ResTemperatures {
+    const MAIN_GRAPH_COLOR: [u8; 3] = [0xe6, 0x61, 0x00];
+
+    pub fn new() -> Self {
+        glib::Object::new::<Self>()
+    }
+
+    pub fn refresh_page(&self, data: Vec<TemperatureData>) {
+        let imp = self.imp();
+        let mut rows = imp.rows.borrow_mut();
+        if imp.groups.borrow().is_empty()
+            || !rows
+                .iter()
+                .map(|r| &r.sensor)
+                .eq(data.iter().map(|d| &d.sensor))
+        {
+            // Reconcile hotplug without losing the history or expansion of remaining sensors.
+            let mut previous: HashMap<PathBuf, SensorRow> =
+                rows.drain(..).map(|r| (r.sensor.path.clone(), r)).collect();
+            for row in previous.values() {
+                if let Some(list) = row.row.parent().and_downcast::<gtk::ListBox>() {
+                    list.remove(&row.row);
+                }
+            }
+            for group in imp.groups.borrow_mut().drain(..) {
+                imp.page.remove(&group);
+            }
+            let mut last_device = None;
+            let mut group = adw::PreferencesGroup::new();
+            for item in &data {
+                let device_path = item.sensor.path.parent().unwrap();
+                if last_device.as_deref() != Some(device_path) {
+                    group = adw::PreferencesGroup::new();
+                    group.set_title(&glib::markup_escape_text(&item.sensor.device));
+                    group
+                        .set_description(Some(&device_path.file_name().unwrap().to_string_lossy()));
+                    imp.page.add(&group);
+                    imp.groups.borrow_mut().push(group.clone());
+                    last_device = Some(device_path.to_path_buf());
+                }
+                let mut row = previous
+                    .remove(&item.sensor.path)
+                    .filter(|row| row.sensor == item.sensor)
+                    .unwrap_or_else(|| {
+                        let row = adw::ExpanderRow::new();
+                        row.set_use_markup(false);
+                        let graph = ResGraph::new();
+                        graph.set_height_request(90);
+                        graph.set_margin_start(12);
+                        graph.set_margin_end(12);
+                        graph.set_margin_top(6);
+                        graph.set_margin_bottom(6);
+                        graph.set_locked_max_y(None);
+                        graph.set_graph_color(0xe6, 0x61, 0x00);
+                        row.add_row(&graph);
+                        SensorRow {
+                            sensor: item.sensor.clone(),
+                            row,
+                            graph,
+                        }
+                    });
+                row.sensor = item.sensor.clone();
+                row.row.set_title(&item.sensor.label);
+                row.row
+                    .set_tooltip_text(Some(&item.sensor.path.to_string_lossy()));
+                group.add(&row.row);
+                rows.push(row);
+            }
+            if data.is_empty() {
+                group.set_title(&i18n("Temperature"));
+                group.set_description(Some(&i18n("N/A")));
+                imp.page.add(&group);
+                imp.groups.borrow_mut().push(group);
+            }
+        }
+        for (row, item) in rows.iter().zip(data) {
+            row.graph.set_visible(item.celsius.is_some());
+            if let Some(celsius) = item.celsius {
+                row.graph.push_data_point(celsius);
+                row.row.set_subtitle(&convert_temperature(celsius));
+            } else {
+                row.row.set_subtitle(&i18n("N/A"));
+            }
+        }
+    }
+}
