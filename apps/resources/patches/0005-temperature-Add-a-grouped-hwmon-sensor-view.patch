--- /dev/null
+++ b/src/utils/temperature.rs
@@ -0,0 +1,185 @@
+//! Generic hwmon temperature discovery. All I/O runs on the refresh worker.
+use std::path::{Path, PathBuf};
+
+use super::read_parsed;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TemperatureSensor {
+    pub path: PathBuf,
+    pub device: String,
+    pub label: String,
+    pub channel: u32,
+}
+
+#[derive(Debug)]
+pub struct TemperatureData {
+    pub sensor: TemperatureSensor,
+    pub celsius: Option<f64>,
+}
+
+fn text(path: impl AsRef<Path>) -> Option<String> {
+    read_parsed::<String>(path).ok().filter(|s| !s.is_empty())
+}
+
+pub fn temperatures(root: &Path) -> Vec<TemperatureData> {
+    let mut data = Vec::new();
+    let Ok(devices) = std::fs::read_dir(root) else {
+        return data;
+    };
+    for device in devices.flatten() {
+        let path = device.path();
+        let id = device.file_name().to_string_lossy().into_owned();
+        if !id
+            .strip_prefix("hwmon")
+            .is_some_and(|n| n.parse::<u32>().is_ok())
+        {
+            continue;
+        }
+        let name = text(path.join("name"))
+            .or_else(|| text(path.join("device/type")))
+            .unwrap_or_else(|| id.clone());
+        let Ok(attributes) = std::fs::read_dir(&path) else {
+            continue;
+        };
+        for attribute in attributes.flatten() {
+            let filename = attribute.file_name();
+            let filename = filename.to_string_lossy();
+            let Some(channel) = filename
+                .strip_prefix("temp")
+                .and_then(|s| s.strip_suffix("_input"))
+                .and_then(|s| s.parse::<u32>().ok())
+                .filter(|n| *n > 0)
+            else {
+                continue;
+            };
+            let stem = format!("temp{channel}");
+            let label = text(path.join(format!("{stem}_label"))).unwrap_or_else(|| stem.clone());
+            let input = attribute.path();
+            // A fault is not a valid measurement even if input still returns a number.
+            let fault = read_parsed::<u32>(path.join(format!("{stem}_fault")))
+                .is_ok_and(|fault| fault != 0);
+            let celsius = if fault {
+                None
+            } else {
+                read_parsed::<i64>(&input).ok().map(|v| v as f64 / 1000.0)
+            };
+            data.push(TemperatureData {
+                sensor: TemperatureSensor {
+                    path: input,
+                    device: name.clone(),
+                    label,
+                    channel,
+                },
+                celsius,
+            });
+        }
+    }
+    // Keep devices together and channels in numeric order, including unlabelled ones.
+    data.sort_by(|a, b| {
+        a.sensor
+            .device
+            .cmp(&b.sensor.device)
+            .then_with(|| a.sensor.path.parent().cmp(&b.sensor.path.parent()))
+            .then_with(|| a.sensor.channel.cmp(&b.sensor.channel))
+    });
+    data
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        fs,
+        sync::atomic::{AtomicUsize, Ordering},
+    };
+
+    struct Fixture(PathBuf);
+    impl Fixture {
+        fn new() -> Self {
+            static NEXT: AtomicUsize = AtomicUsize::new(0);
+            let root = std::env::temp_dir().join(format!(
+                "resources-hwmon-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir_all(&root).unwrap();
+            Self(root)
+        }
+        fn write(&self, name: &str, value: &str) {
+            let path = self.0.join(name);
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            fs::write(path, value).unwrap();
+        }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    #[test]
+    fn multiple_devices_labels_and_numeric_channel_order() {
+        let f = Fixture::new();
+        f.write("hwmon2/name", "chip-b\n");
+        f.write("hwmon2/temp1_input", "42000\n");
+        f.write("hwmon2/temp1_label", "Board\n");
+        f.write("hwmon1/name", "chip-a\n");
+        f.write("hwmon1/temp10_input", "-5000");
+        f.write("hwmon1/temp2_input", "0");
+        f.write("hwmon1/temp2_label", "\n");
+        f.write("hwmon1/temp1_input", "31500");
+        f.write("hwmon1/temp1_label", "Package");
+        f.write("hwmon1/temp1_max", "90000");
+        f.write("hwmon1/temp_input", "90000");
+        f.write("hwmon1/temp0_input", "90000");
+        let data = temperatures(&f.0);
+        assert_eq!(data.len(), 4);
+        assert_eq!(
+            data.iter().map(|d| d.sensor.channel).collect::<Vec<_>>(),
+            [1, 2, 10, 1]
+        );
+        assert_eq!(
+            data.iter().map(|d| d.celsius).collect::<Vec<_>>(),
+            [Some(31.5), Some(0.0), Some(-5.0), Some(42.0)]
+        );
+        assert_eq!(data[0].sensor.label, "Package");
+        assert_eq!(data[1].sensor.label, "temp2");
+        assert_eq!(data[3].sensor.device, "chip-b");
+        assert_eq!(data[3].sensor.label, "Board");
+    }
+
+    #[test]
+    fn failures_recovery_and_device_removal() {
+        let f = Fixture::new();
+        f.write("hwmon0/temp1_input", "not a temperature");
+        f.write("hwmon0/temp2_input", "41000");
+        f.write("hwmon0/temp2_fault", "1");
+        // A dangling attribute simulates a sysfs read error even when tests run as root.
+        std::os::unix::fs::symlink("missing", f.0.join("hwmon0/temp3_input")).unwrap();
+        let data = temperatures(&f.0);
+        assert_eq!(data.len(), 3);
+        assert!(data.iter().all(|d| d.celsius.is_none()));
+        assert_eq!(data[0].sensor.device, "hwmon0");
+        f.write("hwmon0/temp1_input", "22500");
+        f.write("hwmon0/temp2_fault", "0");
+        let data = temperatures(&f.0);
+        assert_eq!(data[0].celsius, Some(22.5));
+        assert_eq!(data[1].celsius, Some(41.0));
+        fs::remove_dir_all(f.0.join("hwmon0")).unwrap();
+        assert!(temperatures(&f.0).is_empty());
+        assert!(temperatures(&f.0.join("absent")).is_empty());
+    }
+
+    #[test]
+    fn class_symlinks_and_thermal_type_fallback() {
+        let f = Fixture::new();
+        f.write("devices/sensor/temp1_input", "32000");
+        f.write("devices/sensor/device/type", "board-thermal\n");
+        fs::create_dir(f.0.join("class")).unwrap();
+        std::os::unix::fs::symlink("../devices/sensor", f.0.join("class/hwmon4")).unwrap();
+        let data = temperatures(&f.0.join("class"));
+        assert_eq!(data.len(), 1);
+        assert_eq!(data[0].sensor.device, "board-thermal");
+        assert_eq!(data[0].celsius, Some(32.0));
+    }
+}
