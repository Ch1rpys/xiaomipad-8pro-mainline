+// Render node minors are allocated independently of primary node minors.
+// Resolve the primary node through sysfs instead of subtracting 128.
+fn drm_node_identifier(drm_class: &Path, node: &Path) -> Option<GpuIdentifier> {
+    fn card_number(name: &str) -> Option<usize> {
+        name.strip_prefix("card")?.parse().ok()
+    }
+
+    let name = node.file_name()?.to_str()?;
+    if let Some(number) = card_number(name) {
+        return Some(GpuIdentifier::Enumerator(number));
+    }
+    name.strip_prefix("renderD")?.parse::<usize>().ok()?;
+    std::fs::read_dir(drm_class.join(name).join("device/drm"))
+        .ok()?
+        .flatten()
+        .find_map(|entry| card_number(entry.file_name().to_str()?).map(GpuIdentifier::Enumerator))
+}
+
+#[cfg(test)]
+mod msm_tests {
+    use super::*;
+
+    #[test]
+    fn render_node_maps_to_card1_and_msm_counters_advance() {
+        let root =
+            std::env::temp_dir().join(format!("resources-msm-fdinfo-{}", std::process::id()));
+        let drm = root.join("sys/class/drm");
+        let device = root.join("sys/devices/platform/ae01000.display-controller");
+        std::fs::create_dir_all(device.join("drm/card1")).unwrap();
+        std::fs::create_dir_all(device.join("drm/card1-DSI-1")).unwrap();
+        std::fs::create_dir_all(drm.join("renderD128")).unwrap();
+        std::os::unix::fs::symlink(&device, drm.join("renderD128/device")).unwrap();
+        let identifier = drm_node_identifier(&drm, Path::new("/dev/dri/renderD128"));
+        assert_eq!(identifier, Some(GpuIdentifier::Enumerator(1)));
+        assert_eq!(
+            identifier,
+            drm_node_identifier(&drm, Path::new("/dev/dri/card1"))
+        );
+        assert_eq!(
+            drm_node_identifier(&drm, Path::new("/dev/dri/renderD129")),
+            None
+        );
+        let fdinfo_path = root.join("fdinfo");
+        std::fs::write(&fdinfo_path, "drm-driver: msm\ndrm-client-id: 7\ndrm-engine-gpu: 1778053180 ns\ndrm-total-memory: 1024 KiB\n").unwrap();
+        let mut fdinfo = Fdinfo {
+            pid: 42,
+            fdinfo_num: 3,
+            gpu_identifier: identifier,
+            content: parse_fdinfo(std::fs::read_to_string(fdinfo_path).unwrap()),
+        };
+        let (id, old) = extract_gpu_usage_from_fdinfo(&fdinfo).unwrap();
+        assert_eq!(id, GpuIdentifier::Enumerator(1));
+        assert_eq!(old.mem(), Some(1048576));
+        fdinfo
+            .content
+            .insert("drm-engine-gpu".into(), "2278053180 ns".into());
+        let stats = other_gpu_usage_stats(&[fdinfo], &mut HashSet::new());
+        assert_eq!(stats[&id].gfx_fraction(&old, 1000), Some(0.5));
+        assert_eq!(stats[&id].gfx_fraction(&old, 0), None);
+        assert_eq!(old.gfx_fraction(&stats[&id], 1000), Some(0.0));
+        assert_eq!(old.greater(&stats[&id]), stats[&id]);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
