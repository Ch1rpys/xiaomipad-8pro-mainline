         trace!(
@@ -326,6 +329,13 @@ impl Battery {
         State::from_str(&read_parsed::<String>(self.sysfs_path.join("status"))?)
     }
 
+    /// Battery temperature in degrees Celsius (power_supply uses tenths of a degree).
+    pub fn temperature(&self) -> Result<f64> {
+        read_parsed::<i64>(self.sysfs_path.join("temp"))
+            .context("unable to read temp sysfs file")
+            .map(|temperature| temperature as f64 / 10.0)
+    }
+
     pub fn charge_cycles(&self) -> Result<usize> {
         read_parsed(self.sysfs_path.join("cycle_count"))
             .context("unable to parse cycle_count sysfs file")
@@ -337,6 +347,26 @@ mod test {
     use super::Battery;
     use pretty_assertions::assert_eq;
 
+    #[test]
+    fn temperature_is_sampled_per_battery_in_tenths_of_a_degree() {
+        let root = std::env::temp_dir().join(format!("resources-battery-{}", std::process::id()));
+        let first = root.join("BAT0");
+        let second = root.join("BAT1");
+        std::fs::create_dir_all(&first).unwrap();
+        std::fs::create_dir_all(&second).unwrap();
+        std::fs::write(first.join("temp"), "325\n").unwrap();
+        std::fs::write(second.join("temp"), "-55\n").unwrap();
+        assert_eq!(super::BatteryData::new(&first).temperature.unwrap(), 32.5);
+        assert_eq!(super::BatteryData::new(&second).temperature.unwrap(), -5.5);
+        std::fs::write(first.join("temp"), "0\n").unwrap();
+        assert_eq!(super::BatteryData::new(&first).temperature.unwrap(), 0.0);
+        std::fs::write(first.join("temp"), "unavailable\n").unwrap();
+        assert!(super::BatteryData::new(&first).temperature.is_err());
+        std::fs::remove_file(second.join("temp")).unwrap();
+        assert!(super::BatteryData::new(&second).temperature.is_err());
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
     #[test]
     fn dont_untangle_untangled_string() {
         let untangled_string = String::from("This is a normal string");
