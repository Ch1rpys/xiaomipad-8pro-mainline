diff --git a/src/devices/gpu/msm.rs b/src/devices/gpu/msm.rs
new file mode 100644
index 0000000..0e973c7
--- /dev/null
+++ b/src/devices/gpu/msm.rs
@@ -0,0 +1,269 @@
+use anyhow::{Context, Result, bail};
+use process_data::gpu_usage::GpuIdentifier;
+
+use std::path::{Path, PathBuf};
+
+use crate::{
+    devices::pci::Device,
+    utils::{read_parsed, thermal},
+};
+
+use super::GpuImpl;
+
+pub const DRIVER_NAMES: &[&str] = &["msm", "msm_dpu", "adreno"];
+
+#[derive(Debug, Clone, Default)]
+
+pub struct MsmGpu {
+    pub device: Option<&'static Device>,
+    pub gpu_identifier: GpuIdentifier,
+    pub driver: String,
+    sysfs_path: PathBuf,
+    first_hwmon_path: Option<PathBuf>,
+    adreno_path: Option<PathBuf>,
+    temperature_paths: Vec<PathBuf>,
+}
+
+impl MsmGpu {
+    pub fn new(
+        device: Option<&'static Device>,
+        gpu_identifier: GpuIdentifier,
+        driver: String,
+        sysfs_path: PathBuf,
+        first_hwmon_path: Option<PathBuf>,
+        sysfs_root: &Path,
+    ) -> Self {
+        let adreno_path = find_adreno_device(&sysfs_path.join("device"), sysfs_root);
+        let temperature_paths =
+            thermal::temperature_paths(&sysfs_root.join("class/thermal"), "gpuss");
+        Self {
+            adreno_path,
+            temperature_paths,
+            device,
+            gpu_identifier,
+            driver,
+            sysfs_path,
+            first_hwmon_path,
+        }
+    }
+
+    fn devfreq_frequency(&self, attribute: &str) -> Result<f64> {
+        let device = self.adreno_path.as_ref().context("no Adreno device")?;
+        for entry in std::fs::read_dir(device.join("devfreq"))?.flatten() {
+            if let Ok(frequency) = read_parsed::<u64>(entry.path().join(attribute)) {
+                return Ok(frequency as f64);
+            }
+        }
+        bail!("no readable Adreno devfreq {attribute}")
+    }
+}
+
+impl GpuImpl for MsmGpu {
+    fn device(&self) -> Option<&'static Device> {
+        self.device
+    }
+
+    fn gpu_identifier(&self) -> GpuIdentifier {
+        self.gpu_identifier
+    }
+
+    fn driver(&self) -> &str {
+        &self.driver
+    }
+
+    fn sysfs_path(&self) -> &Path {
+        &self.sysfs_path
+    }
+
+    fn first_hwmon(&self) -> Option<&Path> {
+        self.first_hwmon_path.as_deref()
+    }
+
+    fn name(&self) -> Result<String> {
+        let compatible = std::fs::read(
+            self.adreno_path
+                .as_ref()
+                .context("no Adreno device")?
+                .join("of_node/compatible"),
+        )?;
+        adreno_name(&compatible).context("no Adreno compatible found")
+    }
+
+    fn usage(&self) -> Result<f64> {
+        // The window aggregates the per-process msm fdinfo engine times.
+        bail!("use per-process msm engine times")
+    }
+
+    fn encode_usage(&self) -> Result<f64> {
+        bail!("encode usage not implemented for msm")
+    }
+
+    fn decode_usage(&self) -> Result<f64> {
+        bail!("decode usage not implemented for msm")
+    }
+
+    fn combined_media_engine(&self) -> Result<bool> {
+        Ok(false)
+    }
+
+    fn used_vram(&self) -> Result<u64> {
+        self.drm_used_vram().map(|usage| usage as u64)
+    }
+
+    fn total_vram(&self) -> Result<u64> {
+        self.drm_total_vram().map(|usage| usage as u64)
+    }
+
+    fn temperature(&self) -> Result<f64> {
+        thermal::maximum_temperature(&self.temperature_paths)
+    }
+
+    fn power_usage(&self) -> Result<f64> {
+        self.hwmon_power_usage()
+    }
+
+    fn core_frequency(&self) -> Result<f64> {
+        self.devfreq_frequency("cur_freq")
+    }
+
+    fn core_frequency_max(&self) -> Result<f64> {
+        self.devfreq_frequency("max_freq")
+    }
+
+    fn vram_frequency(&self) -> Result<f64> {
+        self.hwmon_vram_frequency()
+    }
+
+    fn power_cap(&self) -> Result<f64> {
+        self.hwmon_power_cap()
+    }
+
+    fn power_cap_max(&self) -> Result<f64> {
+        self.hwmon_power_cap_max()
+    }
+}
+
+fn find_adreno_device(drm_device: &Path, sysfs_root: &Path) -> Option<PathBuf> {
+    let is_adreno = |path: &Path| {
+        std::fs::read(path.join("of_node/compatible"))
+            .is_ok_and(|compatible| adreno_name(&compatible).is_some())
+    };
+    if is_adreno(drm_device) {
+        return Some(drm_device.to_path_buf());
+    }
+    // With a display controller as component master, card/device is the DPU,
+    // while devfreq and the GPU compatible belong to the adreno component.
+    let mut devices = std::fs::read_dir(sysfs_root.join("bus/platform/drivers/adreno"))
+        .ok()?
+        .flatten()
+        .map(|entry| entry.path())
+        .filter(|path| is_adreno(path));
+    let device = devices.next()?;
+    // Do not attribute another GPU's telemetry on an ambiguous topology.
+    if devices.next().is_some() {
+        return None;
+    }
+    Some(device)
+}
+
+fn adreno_name(compatible: &[u8]) -> Option<String> {
+    for entry in compatible.split(|byte| *byte == 0) {
+        let entry = std::str::from_utf8(entry).ok()?;
+        if let Some(id) = entry.strip_prefix("qcom,adreno-") {
+            // Chip IDs and marketing names: nvtop's extract_gpuinfo_msm_utils.c.
+            // https://github.com/Syllo/nvtop/blob/71094a9f7dfbfe7cbe9faebfdf055e580a034283/src/extract_gpuinfo_msm_utils.c
+            let name = match id {
+                "43030c00" => "X1-45",
+                "43030b00" => "735",
+                "43050a01" | "43050b00" => "740",
+                "43050c01" => "X1-85",
+                "43051401" => "750",
+                "44050000" | "44050001" => "830",
+                "44050a31" => "840",
+                "44070041" => "X2-85",
+                _ => {
+                    // Older bindings carry a decimal model and patch level.
+                    if let Some((model, _)) = id.split_once('.') {
+                        if model.len() == 3 && model.parse::<u16>().is_ok() {
+                            return Some(format!("Adreno {model}"));
+                        }
+                    }
+                    return Some(format!("Adreno ({id})"));
+                }
+            };
+            return Some(format!("Adreno {name}"));
+        }
+    }
+    compatible
+        .split(|byte| *byte == 0)
+        .any(|entry| entry == b"qcom,adreno")
+        .then(|| "Adreno".to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn dpu_card_reads_adreno_devfreq_and_gpuss_zones() {
+        let root = std::env::temp_dir().join(format!("resources-adreno-{}", std::process::id()));
+        let gpu_path = root.join("bus/platform/drivers/adreno/3d00000.gpu");
+        let devfreq = gpu_path.join("devfreq/3d00000.gpu");
+        std::fs::create_dir_all(&devfreq).unwrap();
+        std::fs::create_dir_all(gpu_path.join("of_node")).unwrap();
+        std::fs::write(
+            gpu_path.join("of_node/compatible"),
+            b"qcom,adreno-44050001\0qcom,adreno\0",
+        )
+        .unwrap();
+        std::fs::write(devfreq.join("cur_freq"), "600000000\n").unwrap();
+        std::fs::write(devfreq.join("max_freq"), "1100000000\n").unwrap();
+        std::fs::create_dir_all(root.join("class/devfreq")).unwrap();
+        std::os::unix::fs::symlink(&devfreq, root.join("class/devfreq/3d00000.gpu")).unwrap();
+        for (index, name, temp) in [
+            (1, "cpu-0-0-0-thermal", "95000"),
+            (22, "gpuss0-thermal", "48000"),
+            (29, "gpuss7-thermal", "52000"),
+        ] {
+            let zone = root.join(format!("class/thermal/thermal_zone{index}"));
+            std::fs::create_dir_all(&zone).unwrap();
+            std::fs::write(zone.join("type"), name).unwrap();
+            std::fs::write(zone.join("temp"), temp).unwrap();
+            let hwmon = root.join(format!("class/hwmon/hwmon{index}"));
+            std::fs::create_dir_all(&hwmon).unwrap();
+            std::fs::write(hwmon.join("name"), name.replace('-', "_")).unwrap();
+            std::fs::write(hwmon.join("temp1_input"), temp).unwrap();
+        }
+        let gpu = MsmGpu::new(
+            None,
+            GpuIdentifier::Enumerator(1),
+            "msm_dpu".into(),
+            root.join("class/drm/card1"),
+            None,
+            &root,
+        );
+        assert_eq!(gpu.name().unwrap(), "Adreno 830");
+        assert_eq!(gpu.gpu_identifier(), GpuIdentifier::Enumerator(1));
+        assert_eq!(gpu.core_frequency().unwrap(), 600_000_000.0);
+        assert_eq!(gpu.core_frequency_max().unwrap(), 1_100_000_000.0);
+        assert_eq!(gpu.temperature().unwrap(), 52.0);
+        assert!(gpu.usage().is_err());
+        std::fs::remove_file(devfreq.join("cur_freq")).unwrap();
+        // Missing current frequency must not be replaced with the maximum.
+        assert!(gpu.core_frequency().is_err());
+        assert_eq!(
+            adreno_name(b"qcom,adreno-43050c01\0qcom,adreno\0").unwrap(),
+            "Adreno X1-85"
+        );
+        assert_eq!(adreno_name(b"qcom,adreno-630.2\0").unwrap(), "Adreno 630");
+        assert_eq!(
+            adreno_name(b"qcom,adreno-99999999\0").unwrap(),
+            "Adreno (99999999)"
+        );
+        let second = root.join("bus/platform/drivers/adreno/other.gpu/of_node");
+        std::fs::create_dir_all(&second).unwrap();
+        std::fs::write(second.join("compatible"), b"qcom,adreno\0").unwrap();
+        assert!(find_adreno_device(&root.join("class/drm/card1/device"), &root).is_none());
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
