+use anyhow::{Context, Result};
+use std::path::{Path, PathBuf};
+
+use super::read_parsed;
+
+// Keep every matching zone: several cores can expose the same type.
+pub fn temperature_paths(root: &Path, prefix: &str) -> Vec<PathBuf> {
+    let Ok(entries) = std::fs::read_dir(root) else {
+        return Vec::new();
+    };
+    entries
+        .flatten()
+        .map(|entry| entry.path())
+        .filter(|path| {
+            path.file_name()
+                .is_some_and(|name| name.to_string_lossy().starts_with("thermal_zone"))
+                && read_parsed::<String>(path.join("type"))
+                    .is_ok_and(|name| name.starts_with(prefix))
+        })
+        .map(|path| path.join("temp"))
+        .collect()
+}
+
+pub fn maximum_temperature(paths: &[PathBuf]) -> Result<f64> {
+    paths
+        .iter()
+        .filter_map(|path| read_parsed::<i64>(path).ok())
+        .max()
+        .map(|temperature| temperature as f64 / 1000.0)
+        .context("no readable temperature sensor found")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cpu_zones_use_the_hottest_readable_sensor() {
+        let root = std::env::temp_dir().join(format!("resources-cpu-{}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        for (index, name, temperature) in [
+            (1, "cpu-0-0-0-thermal", "42000"),
+            (2, "cpu-1-1-1-thermal", "51000"),
+            (3, "cpuss-0-0-thermal", "53000"),
+            (4, "cpu-0-0-0-thermal", "54000"),
+            (5, "gpuss0-thermal", "90000"),
+            (6, "ddr-thermal", "95000"),
+            (7, "cpu-broken-thermal", "unavailable"),
+        ] {
+            let zone = root.join(format!("thermal_zone{index}"));
+            std::fs::create_dir_all(&zone).unwrap();
+            std::fs::write(zone.join("type"), format!("{name}\n")).unwrap();
+            std::fs::write(zone.join("temp"), temperature).unwrap();
+        }
+        let paths = temperature_paths(&root, "cpu");
+        assert_eq!(paths.len(), 5);
+        assert_eq!(maximum_temperature(&paths).unwrap(), 54.0);
+        // Re-read all sensors on each sample, rather than caching the hottest path.
+        std::fs::write(root.join("thermal_zone1/temp"), "61000").unwrap();
+        assert_eq!(maximum_temperature(&paths).unwrap(), 61.0);
+        assert!(maximum_temperature(&[]).is_err());
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
